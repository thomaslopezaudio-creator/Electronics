// Copy this file to include/secrets.h and fill in your network.
// secrets.h is gitignored so your password never ends up in a repo.
#pragma once
#define WIFI_SSID "your-network-name"
#define WIFI_PASS "your-password"
#define HOSTNAME  "ledstrip"   // reachable as http://ledstrip.local

// Fixed address so the UI doesn't depend on .local name lookup (which stalls
// 5 s per request on macOS/iOS with the ESP32's mDNS). Pick one outside the
// router's DHCP pool. Set STATIC_IP to "" to go back to DHCP.
#define STATIC_IP "192.168.1.50"
#define GATEWAY   "192.168.1.254"
#define SUBNET    "255.255.255.0"

// Local timezone as a POSIX TZ string, so the schedule follows the wall clock
// and handles daylight saving on its own. America/Chicago:
#define TZ_POSIX "CST6CDT,M3.2.0,M11.1.0"
